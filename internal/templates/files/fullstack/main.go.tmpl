// Command {{.Name}} is the application: with no arguments it serves HTTP,
// otherwise it runs a console command (go run . list).
package main

import (
	"context"
	"log"
	"os"

	"{{.Name}}/bootstrap"
)

func main() {
	app, err := bootstrap.NewApp()
	if err != nil {
		log.Fatal(err)
	}
	if code, ok := app.Console(os.Args[1:]); ok {
		os.Exit(code)
	}
	if err := app.Run(context.Background()); err != nil {
		app.Log.Error("server stopped", "error", err)
		os.Exit(1)
	}
}
